[Unit]
Description=GymHub Django App
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/gymhub
ExecStart=/var/www/gymhub/venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
Restart=always
RestartSec=3
EnvironmentFile=/var/www/gymhub/.env

[Install]
WantedBy=multi-user.target
